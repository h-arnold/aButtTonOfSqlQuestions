{
  "name": "aButtTonOfSqlQuestions",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "jupyter.kernels.filter": [
          { "path": "/usr/bin/python3", "type": "pythonEnvironment" },
          { "path": "/usr/local/bin/python3", "type": "pythonEnvironment" },
          { "path": "/usr/local/bin/python", "type": "pythonEnvironment" }
        ],
        "jupyter.notebookFileRoot": "${containerWorkspaceFolder}",
        "jupyter.askForKernelRestart": false,
        "notebook.output.scrolling": true,
        "notebook.lineNumbers": "on",
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000
      },
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "qwtel.sqlite-viewer"
      ]
    }
  },
  "postCreateCommand": "bash -lc 'if [ ! -x .venv/bin/python ]; then python -m venv .venv; fi && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -r requirements.txt'"
}
